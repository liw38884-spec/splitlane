# Public application URL used for social metadata. Use the final HTTPS URL when hosted.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional custom RPC endpoints.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Fill only after authorized testnet deployments. Zero or empty addresses keep demo mode active.
NEXT_PUBLIC_SPLITLANE_BASE_SEPOLIA_ADDRESS=
NEXT_PUBLIC_SPLITLANE_ETHEREUM_SEPOLIA_ADDRESS=

# Fill with the registered Base Builder Code before producing attribution evidence.
NEXT_PUBLIC_BASE_BUILDER_CODE=
