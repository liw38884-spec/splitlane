# Ethereum Sepolia read endpoint and authorized SplitLane deployment.
ETHEREUM_SEPOLIA_RPC_URL=
SPLITLANE_ETHEREUM_SEPOLIA_ADDRESS=

# Optional CC3 overrides. Defaults match the current public CC3 testnet services.
CREDITCOIN_CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_CC3_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network/

# Receipt-producing SplitLane functions accepted by the proof lane.
SPLITLANE_ALLOWED_FUNCTION_SIGNATURES=payShare(uint256)

# Polling and timeout controls.
ATTESTCOIN_MIN_CONFIRMATIONS=1
ATTESTCOIN_POLL_INTERVAL_MS=15000
ATTESTCOIN_TIMEOUT_MS=900000
ATTESTCOIN_EXTRA_DELAY_MS=5000
ATTESTCOIN_PROOF_REQUEST_TIMEOUT_MS=30000
